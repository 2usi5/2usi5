<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Youssef Al-Shammari Store</title>
    <style>
        body {
            margin: 0;
            font-family: Tahoma, Arial, sans-serif;
            background: #0f172a;
            color: #fff;
            transition: 0.5s;
        }
        
        header {
            background: linear-gradient(135deg, #0f766e, #1d4ed8);
            padding: 28px 20px;
            text-align: center;
        }
        
        header h1 {
            margin: 0;
            font-size: 28px;
        }
        
        nav {
            display: flex;
            justify-content: center;
            gap: 6px;
            background: #111827;
            flex-wrap: wrap;
            padding: 8px;
        }
        
        nav button {
            background: none;
            border: none;
            color: #fff;
            padding: 14px 20px;
            cursor: pointer;
            font-size: 16px;
            margin: 0 5px;
            transition: 0.3s;
        }
        
        nav button.active,
        nav button:hover {
            background: #0f766e;
        }
        
        section {
            display: none;
            padding: 28px max(16px, 4vw);
            min-height: 70vh;
        }
        
        section.active {
            display: block;
        }
        
        .card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 14px;
            padding: 15px;
            margin: 10px;
            display: inline-block;
            width: min(250px, calc(100% - 42px));
            vertical-align: top;
            text-align: center;
            box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
        }
        
        .card img {
            width: 100%;
            height: 165px;
            object-fit: cover;
            border-radius: 10px;
            background: #334155;
        }
        
        button.primary {
            background: #0b84ff;
            border: none;
            color: #fff;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.3s;
        }
        
        button.primary:hover {
            background: #005fcc;
        }
        
        input,
        textarea,
        select {
            width: 100%;
            max-width: 620px;
            display: block;
            box-sizing: border-box;
            padding: 8px;
            margin: 6px 0;
            border-radius: 6px;
            border: none;
        }
        
        #home {
            text-align: center;
            background-size: cover;
            background-position: center;
            border-radius: 10px;
            padding: 40px 10px;
            transition: 0.5s;
        }
        
        #home h2 {
            font-size: 32px;
            margin-bottom: 10px;
        }
        
        #home p {
            font-size: 18px;
            line-height: 1.6;
            max-width: 700px;
            margin: auto;
        }

        .empty-state { color: #cbd5e1; padding: 30px; }
        .section-heading { max-width: 900px; margin: 0 auto 18px; }
        .danger { background: #b91c1c !important; }
        #cartCount { display: inline-block; min-width: 20px; padding: 2px 6px; border-radius: 999px; background: #f59e0b; color: #111827; font-size: 12px; font-weight: bold; }
        body.light { background: #f1f5f9; color: #0f172a; }
        body.light .card { background: #fff; border-color: #cbd5e1; }
        body.light nav { background: #e2e8f0; }
        body.light nav button { color: #0f172a; }
        body.light footer { background: #e2e8f0; }
        footer { text-align: center; color: #94a3b8; padding: 22px; background: #0b1120; }
        @media (max-width: 600px) {
            header h1 { font-size: 22px; }
            nav button { flex: 1 1 42%; padding: 11px 8px; }
            section { padding: 22px 10px; }
            .card { margin: 8px 4px; }
        }
    </style>
</head>

<body>

    <header>
        <h1 id="storeName">🖥️ Youssef Al-Shammari Store</h1>
    </header>

    <nav>
        <button class="tab-btn active" data-tab="home">🏠 Home</button>
        <button class="tab-btn" data-tab="products">🛍️ Products</button>
        <button class="tab-btn" data-tab="cart">🛒 Cart <span id="cartCount">0</span></button>
        <button class="tab-btn" data-tab="admin">⚙️ Admin</button>
        <button id="toggleLang">العربية</button>
        <button id="toggleCurrency">IQD</button>
        <button id="toggleTheme" type="button">☀️ Theme</button>
    </nav>

    <main>
        <section id="home" class="active">
            <h2 id="homeTitle">Welcome to Youssef Al-Shammari Store</h2>
            <p id="homeDesc">Quality computer products at fair prices.</p>
            <div id="homeProducts"></div>
        </section>

        <section id="products">
            <div class="section-heading">
                <h2 id="productsTitle">Products</h2>
                <p id="productsDesc">Choose a product and add it to your cart.</p>
                <input id="productSearch" type="search" placeholder="Search products..." aria-label="Search products">
            </div>
        </section>

        <section id="cart">
            <h2 id="cartTitle">Shopping Cart</h2>
            <div id="cartItems"></div>
            <h3 id="buyerInfoTitle">Complete your information:</h3>
            <input id="buyerName" placeholder="Full name">
            <input id="buyerPhone" placeholder="Phone number">
            <input id="buyerAddress" placeholder="Address">
            <button class="primary" id="submitOrderBtn" onclick="submitOrder()">Submit order</button>
        </section>

        <section id="admin">
            <h2 id="adminTitle">Admin Panel</h2>
            <button class="primary" id="adminLoginBtn" onclick="promptAdmin()">Login as admin</button>

            <div id="adminPanel" style="display:none; margin-top:10px;">
                <h3>Customize home page</h3>
                <input id="homeTitleInput" placeholder="Home page title">
                <textarea id="homeDescInput" placeholder="Page description"></textarea>
                <input id="homeBgInput" placeholder="Background image URL">
                <label>Text color:</label>
                <input type="color" id="textColorInput">
                <label>Product button color:</label>
                <input type="color" id="btnColorInput">
                <button class="primary" onclick="saveCustomization()">💾 Save customization</button>
                <hr>

                <h3>Add product</h3>
                <input id="pName" placeholder="Product name">
                <input id="pPrice" type="number" placeholder="Price in IQD">
                <input id="pImage" placeholder="Image URL">
                <button class="primary" onclick="addProduct()">Add product</button>
                <div id="adminProductList"></div>
                <hr>

                <h3>Orders</h3>
                <div id="adminOrderList"></div>
            </div>
        </section>
    </main>

    <footer>© 2026 Youssef Al-Shammari Store — Local demo experience</footer>

    <script>
        const defaultProducts = [
            { name: 'معالج Ryzen 7', price: 510000, img: 'https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?auto=format&fit=crop&w=800&q=80' },
            { name: 'قرص SSD 1TB', price: 95000, img: 'https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&fit=crop&w=800&q=80' },
            { name: 'لوحة مفاتيح ميكانيكية', price: 85000, img: 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?auto=format&fit=crop&w=800&q=80' }
        ];
        let products = JSON.parse(localStorage.getItem('products')) || defaultProducts;
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        let orders = JSON.parse(localStorage.getItem('orders')) || [];
        let lang = localStorage.getItem('lang') || 'en';
        let currency = localStorage.getItem('currency') || 'IQD';
        let btnColor = localStorage.getItem('btnColor') || '#0b84ff';
        let textColor = localStorage.getItem('textColor') || '#fff';
        let homeBg = localStorage.getItem('homeBg') || '';
        let searchTerm = '';
        let isLightTheme = localStorage.getItem('theme') === 'light';

        function escapeHTML(value) {
            return String(value ?? '').replace(/[&<>'"]/g, char => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            }[char]));
        }

        function productMarkup(p, i) {
            const price = currency === 'IQD' ? Number(p.price).toLocaleString() + ' د.ع' : (Number(p.price) / 1460).toFixed(2) + ' $';
            const addText = lang === 'ar' ? '🛒 أضف للسلة' : 'Add to Cart';
            const image = escapeHTML(p.img || '');
            return `<div class="card"><img src="${image}" alt="${escapeHTML(p.name)}" loading="lazy" onerror="this.style.display='none'"><h3>${escapeHTML(p.name)}</h3><p>💰 ${price}</p><button class="primary" style="background:${escapeHTML(btnColor)}" onclick="addToCart(${i})">${addText}</button></div>`;
        }

        // عرض المنتجات
        function renderProducts() {
            const div = document.getElementById('products');
            const heading = div.querySelector('.section-heading');
            div.innerHTML = heading ? heading.outerHTML : '';
            const visibleProducts = products
                .map((product, index) => ({ product, index }))
                .filter(({ product }) => product.name.toLowerCase().includes(searchTerm.toLowerCase()));
            div.insertAdjacentHTML('beforeend', visibleProducts.length ? visibleProducts.map(({ product, index }) => productMarkup(product, index)).join('') : '<p class="empty-state">لا توجد منتجات مطابقة للبحث.</p>');
            bindSearch();
            renderHomeProducts();
        }

        function bindSearch() {
            const input = document.getElementById('productSearch');
            if (!input) return;
            input.value = searchTerm;
            input.addEventListener('input', function(event) {
                searchTerm = event.target.value.trim();
                renderProducts();
            });
        }

        function renderHomeProducts() {
            const div = document.getElementById('homeProducts');
            div.innerHTML = products.length ? products.map(productMarkup).join('') : '<p class="empty-state">لا توجد منتجات حاليًا.</p>';
        }

        // السلة
        function addToCart(i) {
            cart.push(products[i]);
            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartCount();
            showToast(lang === 'ar' ? 'تمت الإضافة إلى السلة ✅' : 'Added to cart ✅');
            renderCart();
        }

        function updateCartCount() {
            document.getElementById('cartCount').textContent = cart.length;
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.textContent = message;
            toast.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:10;background:#0f766e;color:#fff;padding:12px 18px;border-radius:10px;box-shadow:0 8px 24px #0005';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2200);
        }

        function renderCart() {
            const list = document.getElementById('cartItems');
            list.innerHTML = '';
            if (cart.length === 0) {
                list.innerHTML = lang === 'ar' ? '<p class="empty-state">السلة فارغة</p>' : '<p class="empty-state">Cart is empty</p>';
                return;
            }
            list.innerHTML = cart.map((p, i) => `<div class="card"><h3>${escapeHTML(p.name)}</h3><p>${Number(p.price).toLocaleString()} د.ع</p><button class="primary danger" onclick="removeCart(${i})">${lang === 'ar' ? 'إزالة' : 'Remove'}</button></div>`).join('');
        }

        function removeCart(i) {
            cart.splice(i, 1);
            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartCount();
            renderCart();
        }

        function submitOrder() {
            const name = document.getElementById('buyerName').value.trim();
            const phone = document.getElementById('buyerPhone').value.trim();
            const address = document.getElementById('buyerAddress').value.trim();
            if (!name || !phone || !address || cart.length === 0) {
                alert(lang === 'ar' ? 'يرجى إدخال جميع المعلومات' : 'Please fill all fields');
                return;
            }
            orders.push({
                name,
                phone,
                address,
                items: [...cart]
            });
            localStorage.setItem('orders', JSON.stringify(orders));
            cart = [];
            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartCount();
            renderCart();
            renderAdminOrders();
            alert(lang === 'ar' ? '✅ تم إرسال الطلب' : 'Order sent ✅');
        }

        // لوحة الإدارة
        function promptAdmin() {
            const pass = prompt(lang === 'ar' ? 'أدخل رمز المالك:' : 'Enter admin code:');
            if (pass === 'yy@55') {
                document.getElementById('adminPanel').style.display = 'block';
                renderAdminProducts();
                renderAdminOrders();
                loadCustomization();
            } else alert(lang === 'ar' ? 'رمز خاطئ' : 'Wrong code');
        }

        function addProduct() {
            const name = document.getElementById('pName').value.trim();
            const price = Number(document.getElementById('pPrice').value);
            const img = document.getElementById('pImage').value.trim();
            if (!name || !Number.isFinite(price) || price <= 0) {
                alert(lang === 'ar' ? 'أدخل الاسم والسعر' : 'Enter name and price');
                return;
            }
            products.push({
                name,
                price,
                img: img || 'https://images.unsplash.com/photo-1517336714739-489689fd1ca8?auto=format&fit=crop&w=800&q=80'
            });
            localStorage.setItem('products', JSON.stringify(products));
            document.getElementById('pName').value = '';
            document.getElementById('pPrice').value = '';
            document.getElementById('pImage').value = '';
            renderProducts();
            renderAdminProducts();
        }

        function renderAdminProducts() {
            const list = document.getElementById('adminProductList');
            list.innerHTML = '';
            list.innerHTML = products.map((p, i) => `<div class="card"><h3>${escapeHTML(p.name)}</h3><button class="primary danger" onclick="deleteProduct(${i})">${lang === 'ar' ? '🗑️ حذف' : '🗑️ Delete'}</button></div>`).join('');
        }

        function deleteProduct(i) {
            products.splice(i, 1);
            localStorage.setItem('products', JSON.stringify(products));
            renderProducts();
            renderAdminProducts();
        }

        function renderAdminOrders() {
            const list = document.getElementById('adminOrderList');
            list.innerHTML = '';
            if (orders.length === 0) {
                list.innerHTML = lang === 'ar' ? '<p>لا توجد طلبات</p>' : '<p>No orders</p>';
                return;
            }
            list.innerHTML = orders.map((o, i) => `<div class="card"><h3>${escapeHTML(o.name)}</h3><p>${escapeHTML(o.phone)}</p><p>${escapeHTML(o.address)}</p><button class="primary danger" onclick="deleteOrder(${i})">${lang === 'ar' ? '❌ حذف' : '❌ Delete'}</button></div>`).join('');
        }

        function deleteOrder(i) {
            orders.splice(i, 1);
            localStorage.setItem('orders', JSON.stringify(orders));
            renderAdminOrders();
        }

        // تخصيص الصفحة الرئيسية والخلفيات
        function saveCustomization() {
            const title = document.getElementById('homeTitleInput').value;
            const desc = document.getElementById('homeDescInput').value;
            const bg = document.getElementById('homeBgInput').value;
            const text = document.getElementById('textColorInput').value;
            const btn = document.getElementById('btnColorInput').value;
            localStorage.setItem('homeTitle', title);
            localStorage.setItem('homeDesc', desc);
            localStorage.setItem('homeBg', bg);
            localStorage.setItem('textColor', text);
            localStorage.setItem('btnColor', btn);
            loadCustomization();
        }

        function loadCustomization() {
            const title = localStorage.getItem('homeTitle') || (lang === 'en' ? 'Welcome to Youssef Al-Shammari Store' : 'أهلاً بكم في متجر يوسف الشمري');
            const desc = localStorage.getItem('homeDesc') || (lang === 'en' ? 'Quality computer products at fair prices.' : 'نوفر لكم أفضل المنتجات بأعلى جودة وأفضل الأسعار.');
            homeBg = localStorage.getItem('homeBg') || '';
            textColor = localStorage.getItem('textColor') || '#fff';
            btnColor = localStorage.getItem('btnColor') || '#0b84ff';
            document.getElementById('homeTitle').innerText = title;
            document.getElementById('homeDesc').innerText = desc;
            document.body.style.color = textColor;
            if (homeBg) document.getElementById('home').style.background = `url(${homeBg}) no-repeat center center / cover`;
        }

        // اللغة والعملة
        document.getElementById('toggleLang').onclick = function() {
            lang = (lang === 'ar') ? 'en' : 'ar';
            localStorage.setItem('lang', lang);
            updateLanguage();
            renderProducts();
            renderCart();
            renderAdminOrders();
        };
        document.getElementById('toggleCurrency').onclick = function() {
            currency = (currency === 'IQD') ? 'USD' : 'IQD';
            localStorage.setItem('currency', currency);
            document.getElementById('toggleCurrency').innerText = currency;
            renderProducts();
        };

        document.getElementById('toggleTheme').onclick = function() {
            isLightTheme = !isLightTheme;
            document.body.classList.toggle('light', isLightTheme);
            localStorage.setItem('theme', isLightTheme ? 'light' : 'dark');
            this.textContent = isLightTheme ? '🌙 Theme' : '☀️ Theme';
        };

        function updateLanguage() {
            if (lang === 'ar') {
                document.getElementById('toggleLang').innerText = 'English';
                document.querySelector('html').dir = 'rtl';
                document.querySelector('html').lang = 'ar';
                document.getElementById('storeName').innerText = '🖥️ متجر يوسف الشمري';
                document.getElementById('homeTitle').innerText = localStorage.getItem('homeTitle') || 'أهلاً بكم في متجر يوسف الشمري';
                document.getElementById('homeDesc').innerText = localStorage.getItem('homeDesc') || 'نوفر لكم أفضل المنتجات بأعلى جودة وأفضل الأسعار.';
                document.querySelector('[data-tab="home"]').innerText = '🏠 الرئيسية';
                document.querySelector('[data-tab="products"]').innerText = '🛍️ المنتجات';
                document.querySelector('[data-tab="cart"]').innerHTML = '🛒 السلة <span id="cartCount">' + cart.length + '</span>';
                document.querySelector('[data-tab="admin"]').innerText = '⚙️ الإدارة';
                document.getElementById('productsTitle').innerText = 'المنتجات';
                document.getElementById('productsDesc').innerText = 'اختر ما يناسبك وأضفه إلى السلة.';
                document.getElementById('productSearch').placeholder = 'ابحث عن منتج...';
                document.getElementById('cartTitle').innerText = 'سلة المشتريات';
                document.getElementById('buyerInfoTitle').innerText = 'أكمل معلوماتك:';
                document.getElementById('submitOrderBtn').innerText = 'إرسال الطلب';
                document.getElementById('adminTitle').innerText = 'لوحة الإدارة';
                document.getElementById('adminLoginBtn').innerText = 'دخول كمالك';
            } else {
                document.getElementById('toggleLang').innerText = 'العربية';
                document.querySelector('html').dir = 'ltr';
                document.querySelector('html').lang = 'en';
                document.getElementById('storeName').innerText = '🖥️ Youssef Al-Shammari Store';
                document.getElementById('homeTitle').innerText = localStorage.getItem('homeTitle') || 'Welcome to Youssef Al-Shammari Store';
                document.getElementById('homeDesc').innerText = localStorage.getItem('homeDesc') || 'Quality computer products at fair prices.';
                document.querySelector('[data-tab="home"]').innerText = '🏠 Home';
                document.querySelector('[data-tab="products"]').innerText = '🛍️ Products';
                document.querySelector('[data-tab="cart"]').innerHTML = '🛒 Cart <span id="cartCount">' + cart.length + '</span>';
                document.querySelector('[data-tab="admin"]').innerText = '⚙️ Admin';
                document.getElementById('productsTitle').innerText = 'Products';
                document.getElementById('productsDesc').innerText = 'Choose a product and add it to your cart.';
                document.getElementById('productSearch').placeholder = 'Search products...';
                document.getElementById('cartTitle').innerText = 'Shopping Cart';
                document.getElementById('buyerInfoTitle').innerText = 'Complete your information:';
                document.getElementById('submitOrderBtn').innerText = 'Submit order';
                document.getElementById('adminTitle').innerText = 'Admin Panel';
                document.getElementById('adminLoginBtn').innerText = 'Login as admin';
            }
            document.getElementById('toggleTheme').textContent = isLightTheme ? '🌙 Theme' : '☀️ Theme';
            updateCartCount();
        }

        // تبديل الصفحات
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                document.querySelectorAll('section').forEach(sec => sec.classList.remove('active'));
                document.getElementById(btn.dataset.tab).classList.add('active');
            });
        });

        // تشغيل
        updateLanguage();
        document.body.classList.toggle('light', isLightTheme);
        document.getElementById('toggleTheme').textContent = isLightTheme ? '🌙 الوضع' : '☀️ الوضع';
        updateCartCount();
        renderProducts();
        renderCart();
        renderAdminOrders();
        loadCustomization();
    </script>

</body>

</html>
